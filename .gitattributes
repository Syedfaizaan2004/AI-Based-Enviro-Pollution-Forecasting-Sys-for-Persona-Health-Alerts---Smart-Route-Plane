# =============================================================================
# .gitattributes
# Project : AI-Based Environmental Pollution Forecasting System
#           Personal Health Alerts & Smart Route Planning
# =============================================================================
#
# Rules here control:
#   1. Line-ending normalisation (text vs binary)
#   2. Git LFS tracking for large ML model files
#   3. Diff / merge strategy overrides for generated/binary files
#   4. Linguist overrides so GitHub shows the correct language breakdown
#
# Reference: https://git-scm.com/docs/gitattributes
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# GLOBAL DEFAULT
# Normalise all text files to LF in the repository.
# Developers on Windows will get CRLF checked out locally (core.autocrlf).
# ─────────────────────────────────────────────────────────────────────────────

*           text=auto eol=lf


# ─────────────────────────────────────────────────────────────────────────────
# PYTHON — BACKEND (FastAPI · SQLAlchemy · Alembic)
# ─────────────────────────────────────────────────────────────────────────────

*.py        text eol=lf diff=python
*.pyi       text eol=lf diff=python
*.pyw       text eol=lf diff=python
*.cfg       text eol=lf
*.ini       text eol=lf
*.toml      text eol=lf
*.txt       text eol=lf

# Alembic migration scripts are plain Python
backend/alembic/versions/*.py  text eol=lf diff=python


# ─────────────────────────────────────────────────────────────────────────────
# JAVASCRIPT / TYPESCRIPT — FRONTEND (React · Vite · Tailwind)
# ─────────────────────────────────────────────────────────────────────────────

*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf


# ─────────────────────────────────────────────────────────────────────────────
# WEB ASSETS
# ─────────────────────────────────────────────────────────────────────────────

*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.sass      text eol=lf
*.less      text eol=lf
*.svg       text eol=lf


# ─────────────────────────────────────────────────────────────────────────────
# DATA & CONFIG FORMATS
# ─────────────────────────────────────────────────────────────────────────────

*.json      text eol=lf
*.jsonc     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.xml       text eol=lf
*.env       text eol=lf
*.env.example  text eol=lf
*.md        text eol=lf diff=markdown
*.rst       text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.tsv       text eol=lf


# ─────────────────────────────────────────────────────────────────────────────
# SHELL SCRIPTS
# ─────────────────────────────────────────────────────────────────────────────

*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.fish      text eol=lf
Makefile    text eol=lf
makefile    text eol=lf


# ─────────────────────────────────────────────────────────────────────────────
# JUPYTER NOTEBOOKS
# Stored as JSON — text, but use a dedicated diff driver for readability.
# ─────────────────────────────────────────────────────────────────────────────

*.ipynb     text eol=lf diff=jupyternotebook merge=jupyternotebook


# ─────────────────────────────────────────────────────────────────────────────
# BINARY FILES — no LF normalisation, no text diff
# ─────────────────────────────────────────────────────────────────────────────

# Images
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.tiff      binary
*.bmp       binary
*.psd       binary

# Fonts
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary

# Audio / Video
*.mp3       binary
*.mp4       binary
*.wav       binary
*.ogg       binary
*.webm      binary
*.avi       binary

# Archives
*.zip       binary
*.tar       binary
*.gz        binary
*.tgz       binary
*.rar       binary
*.7z        binary

# Office documents
*.pdf       binary
*.docx      binary
*.xlsx      binary
*.pptx      binary


# ─────────────────────────────────────────────────────────────────────────────
# GIT LFS — LARGE ML MODEL FILES
#
# These files are tracked in Git history via LFS pointers so the repo
# stays lightweight. Actual binary blobs are stored on the LFS server.
#
# Covered locations:
#   backend/app/models/   ← inference bundle served by FastAPI (Week 3+)
#   models/               ← training artefacts used by notebooks
# ─────────────────────────────────────────────────────────────────────────────

# CatBoost binary model
*.cbm                                       filter=lfs diff=lfs merge=lfs -text
backend/app/models/catboost_model.cbm       filter=lfs diff=lfs merge=lfs -text

# scikit-learn / LightGBM / joblib pickles
*.pkl                                       filter=lfs diff=lfs merge=lfs -text
backend/app/models/lightgbm_model.pkl       filter=lfs diff=lfs merge=lfs -text
backend/app/models/robust_scaler.pkl        filter=lfs diff=lfs merge=lfs -text
backend/app/models/selected_features.pkl    filter=lfs diff=lfs merge=lfs -text
backend/app/models/ensemble_info.pkl        filter=lfs diff=lfs merge=lfs -text

# XGBoost JSON model — also track via LFS (can be several MB)
backend/app/models/xgboost_model.json       filter=lfs diff=lfs merge=lfs -text
models/xgboost_model.json                   filter=lfs diff=lfs merge=lfs -text

# Generic large ML formats (if generated later)
*.pt                                        filter=lfs diff=lfs merge=lfs -text
*.pth                                       filter=lfs diff=lfs merge=lfs -text
*.h5                                        filter=lfs diff=lfs merge=lfs -text
*.hdf5                                      filter=lfs diff=lfs merge=lfs -text
*.onnx                                      filter=lfs diff=lfs merge=lfs -text
*.keras                                     filter=lfs diff=lfs merge=lfs -text
*.joblib                                    filter=lfs diff=lfs merge=lfs -text


# ─────────────────────────────────────────────────────────────────────────────
# GITHUB LINGUIST OVERRIDES
# Ensure GitHub's language breakdown reflects real source, not generated files.
# ─────────────────────────────────────────────────────────────────────────────

# Frontend build output — don't count toward language stats
frontend/dist/**            linguist-generated=true

# Alembic migration files are generated code
backend/alembic/versions/*  linguist-generated=true

# Notebook outputs (cells) are not handwritten source
Notebook/**                 linguist-documentation=true

# package-lock.json is generated — exclude from language detection
package-lock.json           linguist-generated=true
frontend/package-lock.json  linguist-generated=true


# ─────────────────────────────────────────────────────────────────────────────
# MERGE STRATEGY OVERRIDES
# ─────────────────────────────────────────────────────────────────────────────

# Always take ours on lock files to avoid noisy merge conflicts
package-lock.json           merge=ours
frontend/package-lock.json  merge=ours

# Alembic version table — manual resolution always safer than auto-merge
backend/alembic/versions/*  merge=ours
