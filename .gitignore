Notebook/catboost_info/
catboost_info/
artifacts/
checkpoints/
outputs/
runs/
mlruns/
wandb/
lightning_logs/
tensorboard/
logs/

# -----------------------------------------------------------------------------
# Project datasets
# Data/ currently contains raw and processed AQI datasets, including a 2 GB tree.
# Keep directory docs/placeholders trackable when needed.
# -----------------------------------------------------------------------------
/[Dd]ata/**
!/[Dd]ata/
!/[Dd]ata/**/
!/[Dd]ata/**/.gitkeep
!/[Dd]ata/**/README*

# -----------------------------------------------------------------------------
# Generated reports and plots
# Reports/ contains EDA summaries and figures regenerated from notebooks.
# Keep directory docs/placeholders trackable when needed.
# -----------------------------------------------------------------------------
/[Rr]eports/**
!/[Rr]eports/
!/[Rr]eports/**/
!/[Rr]eports/**/.gitkeep
!/[Rr]eports/**/README*

# -----------------------------------------------------------------------------
# Trained model artifacts and prediction dumps
# Keep only the artifacts required by Notebook/07_inference.ipynb uploadable.
# -----------------------------------------------------------------------------
/[Mm]odels/**
!/[Mm]odels/
!/[Mm]odels/**/
!/[Mm]odels/**/.gitkeep
!/[Mm]odels/**/README*

