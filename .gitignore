# Project: environmental pollution forecasting notebooks
# Repo scan summary:
# - Source/docs: README.md and Notebook/*.ipynb
# - Local/generated: .venv/, .env, Data/, Reports/, most model outputs,
#   Notebook/catboost_info/

# -----------------------------------------------------------------------------
# OS and filesystem noise
# -----------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Local environment, secrets, and credentials
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
.envrc
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
config/local.*
local_settings.py

# -----------------------------------------------------------------------------
# Python virtual environments and interpreter-local files
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.conda/
.mamba/
envs/
__pypackages__/
.python-version

# -----------------------------------------------------------------------------
