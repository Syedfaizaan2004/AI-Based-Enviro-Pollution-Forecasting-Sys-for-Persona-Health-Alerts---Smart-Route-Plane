*.db
*.sqlite
*.sqlite3
*.sql.bak
pgdata/
postgres-data/


# ─────────────────────────────────────────────────────────────────────────────
# 9. JUPYTER NOTEBOOKS
# Keep all .ipynb files in Notebook/ tracked.
# Ignore runtime-generated checkpoints and local kernel state.
# ─────────────────────────────────────────────────────────────────────────────

.ipynb_checkpoints/
*/.ipynb_checkpoints/
**/.ipynb_checkpoints/
.jupyter/
.ipython/
*.nbconvert.ipynb
profile_default/
ipython_config.py


# ─────────────────────────────────────────────────────────────────────────────
# 10. MACHINE LEARNING — TRAINING ARTIFACTS
# CatBoost, LightGBM, XGBoost, scikit-learn training run outputs.
# The final inference bundle inside backend/app/models/ and models/ is KEPT.
# ─────────────────────────────────────────────────────────────────────────────

# CatBoost training run directories (generated during notebook training)
catboost_info/
Notebook/catboost_info/
backend/catboost_info/

# MLflow / Weights & Biases / TensorBoard experiment tracking
mlruns/
wandb/
lightning_logs/
tensorboard/
runs/

# Training checkpoints and intermediate model dumps
checkpoints/
artifacts/
outputs/

# Common ML artifact extensions — ignored GLOBALLY
# (the specific required inference files are re-allowed below)
*.cbm
*.ckpt
*.joblib
*.pkl
*.pickle
*.sav
*.pt
*.pth
*.h5
*.hdf5
*.keras
*.onnx
*.npy
*.npz
*.parquet
*.feather
events.out.tfevents.*


# ── Re-allow the required inference bundle ────────────────────────────────────

# backend/app/models/ — served by FastAPI prediction layer (Week 3+)
!backend/app/models/catboost_model.cbm
!backend/app/models/lightgbm_model.pkl
!backend/app/models/xgboost_model.json
!backend/app/models/robust_scaler.pkl
!backend/app/models/selected_features.pkl
!backend/app/models/ensemble_info.pkl

# models/ — results and artefacts used by Notebook/07_inference.ipynb
!models/best_tree_model.txt
!models/tree_predictions.csv
!models/tree_model_results.csv


